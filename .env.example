# Copy to .env (gitignored) and replace every value before `docker compose up --build`.
# Never commit real secrets. Values left empty must be filled in, or compose refuses to start.

# PostgreSQL database created on first start. Avoid ';' in the password (it ends up in a connection string).
POSTGRES_DB=employee_payroll
POSTGRES_USER=payroll
POSTGRES_PASSWORD=change-me-postgres-password

# HS256 signing key for the API's JWTs: at least 32 bytes (256 bits). Deliberately empty, so compose refuses to start
# until you set your own. Generate one with
#   openssl rand -base64 48
# or in PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_KEY=

# Password of the seeded demo logins: hr@acme.test, sara.ahmed@acme.test, omar.hassan@acme.test
DEMO_PASSWORD=change-me-demo-password
