    <AssemblyName>EmployeePayroll.Api</AssemblyName>
    <UserSecretsId>3f6d7d0e-6a0e-4a3b-9a7e-2f0c1f4b9e11</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
