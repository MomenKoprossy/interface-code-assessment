<Project Sdk="Microsoft.NET.Sdk">

  <!--
    References Core only; opt-in capabilities (caching/messaging/grpc) are wired by the
    service via those packages' own extension methods, so Web stays dependency-lean.
  -->
  <PropertyGroup>
    <RootNamespace>BuildingBlocks.Web</RootNamespace>
    <Description>ASP.NET Core web-edge building block: AddPlatform/UsePlatform composition, ProblemDetails + global exception handler, Result-to-IResult mapping, JWT bearer, permission authorization ([HasPermission]), rate limiting, and security headers.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuildingBlocks.Core\BuildingBlocks.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="NetEscapades.AspNetCore.SecurityHeaders" />
  </ItemGroup>

</Project>
