<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BuildingBlocks.Caching = HybridCache registration (L1 in-memory, Redis L2 only when a `cache` connection string exists).
    Growth path: built and tested in BuildingBlocks.slnx, not referenced by the app (see .claude/docs/scalability.md).
  -->
  <PropertyGroup>
    <RootNamespace>BuildingBlocks.Caching</RootNamespace>
    <Description>Caching building block: AddPlatformCaching registers HybridCache with platform defaults and a Redis L2 when configured.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
  </ItemGroup>

</Project>
