<Solution>
  <!--
    All seven vendored building blocks + their unit tests. The app (../../EmployeePayroll.slnx) references only
    Core, Data and Web; Caching, Messaging, Grpc and Storage are the growth path (see docs/scalability.md) and are
    built + tested here (and in CI) so they stay healthy without entering the app's dependency graph.
  -->
  <Project Path="BuildingBlocks.Core/BuildingBlocks.Core.csproj" />
  <Project Path="BuildingBlocks.Data/BuildingBlocks.Data.csproj" />
  <Project Path="BuildingBlocks.Web/BuildingBlocks.Web.csproj" />
  <Project Path="BuildingBlocks.Caching/BuildingBlocks.Caching.csproj" />
  <Project Path="BuildingBlocks.Messaging/BuildingBlocks.Messaging.csproj" />
  <Project Path="BuildingBlocks.Grpc/BuildingBlocks.Grpc.csproj" />
  <Project Path="BuildingBlocks.Storage/BuildingBlocks.Storage.csproj" />
  <Folder Name="/tests/">
    <Project Path="tests/BuildingBlocks.UnitTests/BuildingBlocks.UnitTests.csproj" />
  </Folder>
</Solution>
