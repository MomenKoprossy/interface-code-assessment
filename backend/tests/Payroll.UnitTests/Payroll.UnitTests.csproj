  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Payroll\Payroll\Payroll.csproj" />
    <ProjectReference Include="..\..\src\Modules\Payroll\Payroll.Infrastructure\Payroll.Infrastructure.csproj" />
  </ItemGroup>

</Project>
